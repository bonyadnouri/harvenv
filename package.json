{
  "name": "harvenv",
  "version": "0.0.0",
  "private": true,
  "description": "Harness virtual environments for Claude Code",
  "type": "module",
  "bin": {
    "harv": "./bin/harv.ts"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "verify:launch-recipe": "node scripts/verify-launch-recipe.ts",
    "verify:skeleton": "node scripts/verify-walking-skeleton.ts",
    "verify:sync": "node scripts/verify-sync-store.ts",
    "verify:settings": "node scripts/verify-manifest-settings.ts",
    "verify:plugins": "node scripts/verify-plugin-pins.ts",
    "verify:tripwire": "node scripts/verify-tripwire.ts",
    "verify:ci": "node scripts/verify-ci-recipe.ts",
    "verify:shim": "node scripts/verify-shim.ts",
    "verify:overlay": "node scripts/verify-overlay.ts",
    "verify:packaging": "bun scripts/verify-packaging.ts",
    "vendor:mise": "bun scripts/vendor-mise.ts",
    "build": "bun scripts/build.ts"
  },
  "dependencies": {
    "smol-toml": "^1.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
